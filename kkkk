  <script>
    let player;
    let ui;

    function buildClearKeysMap(kidsRaw, keysRaw) {
      const clearKeysMap = {};
      if (!kidsRaw) return clearKeysMap;

      const kidLines = kidsRaw.split(/[\r\n,]+/).map(s => s.trim()).filter(Boolean);
      const keyLines = (keysRaw || '').split(/[\r\n,]+/).map(s => s.trim()).filter(Boolean);

      kidLines.forEach((line, index) => {
        if (line.includes(':')) {
          const [kId, kVal] = line.split(':');
          if (kId && kVal) {
            clearKeysMap[kId.trim().toLowerCase()] = kVal.trim().toLowerCase();
          }
        } else if (keyLines[index]) {
          clearKeysMap[line.toLowerCase()] = keyLines[index].toLowerCase();
        }
      });

      return clearKeysMap;
    }

    function getClientDirectUrl() {
      const mpdUrl = document.getElementById('mpdUrl').value.trim();
      const kidsRaw = document.getElementById('kidsInput').value.trim();
      const keysRaw = document.getElementById('keysInput').value.trim();

      const map = buildClearKeysMap(kidsRaw, keysRaw);
      const combinedKeys = Object.entries(map)
        .map(([k, v]) => `${k}:${v}`)
        .join(',');

      const baseUrl = window.location.origin + window.location.pathname;
      const params = new URLSearchParams();
      params.set('client', '1');
      if (mpdUrl) params.set('mpd', mpdUrl);
      if (combinedKeys) params.set('keys', combinedKeys);

      return `${baseUrl}?${params.toString()}`;
    }

    async function copyClientLink() {
      const link = getClientDirectUrl();
      try {
        await navigator.clipboard.writeText(link);
        setStatus('Client video link copied!', 'success');
      } catch {
        prompt('انسخ لينك العميل المباشر:', link);
      }
    }

