      max-width: 1200px;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      background: #141414;
      border: 1px solid #8b0000;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 0 25px rgba(229, 9, 20, 0.15);
    }
    @media (max-width: 850px) {
      .container { grid-template-columns: 1fr; }
    }
    .player-wrapper {
      width: 100%;
      background: #000;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #2a2a2a;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 360px;
    }
    .player-wrapper video {
      width: 100%;
      height: 100%;
      max-height: 520px;
    }
    .controls-panel {
      background: #1a1a1a;
      padding: 18px;
      border-radius: 8px;
      border: 1px solid #2a2a2a;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    label {
      font-size: 0.85rem;
      color: #aaa;
      margin-bottom: 4px;
      display: block;
      text-align: left;
      direction: ltr;
    }
    input, textarea {
      width: 100%;
      background: #111;
      border: 1px solid #333;
      color: #fff;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      direction: ltr;
      text-align: left;
      outline: none;
      transition: border 0.2s;
    }
    input:focus, textarea:focus { border-color: #ff2a2a; }
    textarea { resize: vertical; min-height: 85px; font-family: monospace; }
    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 8px;
    }
    button {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      font-size: 0.95rem;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-submit { background: #ffffff; color: #000; }
    .btn-submit:hover { background: #e0e0e0; }
    .btn-clear { background: #2b2b2b; color: #ccc; flex: 0.4; }
    .btn-clear:hover { background: #3a3a3a; }
    .btn-copy {
      background: #8b0000;
      color: #fff;
      margin-top: 4px;
    }
    .btn-copy:hover { background: #a80000; }
    .status-box {
      font-size: 0.82rem;
      padding: 8px 10px;
      border-radius: 6px;
      background: #111;
      border-left: 3px solid #555;
      direction: ltr;
      text-align: left;
      word-break: break-word;
    }
    .status-error { border-left-color: #ff2a2a; color: #ff6b6b; }
    .status-success { border-left-color: #2ecc71; color: #2ecc71; }

    /* وضع العميل: الفيديو فقط بملء الشاشة */
    body.client-mode {
      padding: 0;
      background: #000;
      overflow: hidden;
    }
    body.client-mode .header,
    body.client-mode .controls-panel {
      display: none !important;
    }
    body.client-mode .container {
      display: block;
      width: 100vw;
      height: 100vh;
      max-width: none;
      padding: 0;
      margin: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: #000;
    }
    body.client-mode .player-wrapper {
      width: 100%;
      height: 100%;
      min-height: 100vh;
      border: none;
      border-radius: 0;
    }
    body.client-mode .player-wrapper video {
      width: 100%;
      height: 100%;
      max-height: none;
      object-fit: contain;
    }
  </style>
</head>
